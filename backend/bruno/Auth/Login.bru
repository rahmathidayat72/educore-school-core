meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@sekolah.id",
    "password": "adminpassword"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody().data;
    if (data && data.token) {
      bru.setEnvVar("token", data.token);
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
