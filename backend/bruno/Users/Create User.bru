meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users/tambah
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "guru_andi",
    "email": "andi@sekolah.id",
    "password": "password123",
    "role": "guru"
  }
}

assert {
  res.status: eq 201
}
