meta {
  name: Update Mapel
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/mapel/update?id=your_mapel_id_here
  body: json
  auth: bearer
}

params:query {
  id: your_mapel_id_here
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "mata_pelajaran": "Matematika Peminatan",
    "id_guru": "your_guru_id_here",
    "kelas_id": "your_kelas_id_here",
    "deskripsi": "Mata pelajaran Matematika Peminatan Kelas 10"
  }
}

assert {
  res.status: eq 200
}
